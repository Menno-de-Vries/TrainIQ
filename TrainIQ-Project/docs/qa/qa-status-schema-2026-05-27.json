{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrainIQ QA Status",
  "type": "object",
  "required": [
    "date",
    "project",
    "schema",
    "status",
    "releaseReadyByFullDefinitionOfDone",
    "notRunRows",
    "notRunSnapshot",
    "knownOpenP0P1P2FromExecutedChecks",
    "fixedFindings",
    "latestAutomatedBaseline",
    "latestRuntimeSmoke",
    "openReleaseGates",
    "handoffDocuments"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "project": {
      "const": "TrainIQ"
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL"]
    },
    "releaseReadyByFullDefinitionOfDone": {
      "type": "boolean"
    },
    "notRunRows": {
      "type": "integer",
      "minimum": 0
    },
    "notRunSnapshot": {
      "type": "string"
    },
    "knownOpenP0P1P2FromExecutedChecks": {
      "type": "integer",
      "minimum": 0
    },
    "fixedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "area", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^QA-\\d{4}-\\d{2}-\\d{2}-\\d{3}$"
          },
          "priority": {
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["fixed", "open", "deferred"]
          }
        },
        "additionalProperties": false
      }
    },
    "latestAutomatedBaseline": {
      "type": "object",
      "required": ["assembleDebug", "testDebugUnitTest", "lintDebug", "connectedDebugAndroidTest"],
      "additionalProperties": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "latestRuntimeSmoke": {
      "type": "object",
      "required": ["status", "uiDump", "logcat", "crashAnrScan"],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL", "NOT RUN"]
        },
        "uiDump": {
          "type": "string"
        },
        "logcat": {
          "type": "string"
        },
        "crashAnrScan": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "openReleaseGates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "handoffDocuments": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "checkResult": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL", "NOT RUN"]
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
